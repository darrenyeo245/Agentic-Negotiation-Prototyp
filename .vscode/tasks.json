{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Demo: Einigung",
      "type": "process",
      "command": "python",
      "args": ["main.py"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "Demo: Abbruch",
      "type": "process",
      "command": "python",
      "args": ["main.py", "--config", "config/no_deal.json"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "Browser-Oberfläche",
      "type": "process",
      "command": "python",
      "args": ["gui.py"],
      "options": {"cwd": "${workspaceFolder}"},
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Alle Tests",
      "type": "process",
      "command": "python",
      "args": ["-m", "unittest", "discover", "-s", "tests", "-v"],
      "options": {"cwd": "${workspaceFolder}"},
      "group": {"kind": "test", "isDefault": true},
      "problemMatcher": []
    }
  ]
}
